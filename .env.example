# ODOSIAN AI Engine - environment template.
# Copy to .env and fill in. Only secrets and per-machine overrides belong here;
# every other setting lives in configs/.

# --- Secrets ---------------------------------------------------------------
# Names are declared in configs/security.yaml and read with the ODOSIAN_ prefix.
ODOSIAN_LLM_API_KEY=

# --- Optional overrides of configs/*.yaml ----------------------------------
# Any variable left unset falls back to the value in the YAML files.
ODOSIAN_ENVIRONMENT=development
ODOSIAN_LOG_LEVEL=INFO
ODOSIAN_LOG_FORMAT=json
ODOSIAN_LOG_OUTPUT=stdout
ODOSIAN_MODEL_PROVIDER=gemini
ODOSIAN_MODEL_NAME=gemini-3.5-flash
ODOSIAN_MODEL_TEMPERATURE=0.2
